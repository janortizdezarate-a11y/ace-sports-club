<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ace Sport Club - Pallejà</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- AOS Animation Library CDN -->
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

    <!-- Header & Navigation -->
    <header class="fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-md shadow-sm z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center space-x-3">
                <img src="assets/logo.png" alt="Ace Sport Club" class="h-12 w-auto onerror-fallback" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                <span class="text-2xl font-black text-green-600 hidden uppercase tracking-wider">Ace Sport Club</span>
            </a>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center space-x-6 font-semibold text-sm text-gray-600">
                <a href="#home" class="hover:text-green-600 transition" data-i18n="nav_home">Home</a>
                <a href="#facilities" class="hover:text-green-600 transition" data-i18n="nav_facilities">Facilities</a>
                <a href="#opportunities" class="hover:text-green-600 transition" data-i18n="nav_opportunities">Opportunities</a>
                <a href="#classes" class="hover:text-green-600 transition" data-i18n="nav_classes">Classes</a>
                <a href="#memberships" class="hover:text-green-600 transition" data-i18n="nav_memberships">Memberships</a>
                <a href="#contact" class="hover:text-green-600 transition" data-i18n="nav_contact">Contact</a>
            </nav>

            <!-- Language Switcher & Mobile Menu Button -->
            <div class="flex items-center space-x-4">
                <select id="language-select" class="bg-gray-100 border border-gray-300 text-gray-700 py-1 px-3 rounded-md text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-green-500">
                    <option value="en">EN</option>
                    <option value="es">ES</option>
                    <option value="ca">CA</option>
                </select>

                <button id="mobile-menu-btn" class="md:hidden text-gray-700 hover:text-green-600 text-2xl focus:outline-none">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-200 px-4 pt-2 pb-6 space-y-3">
            <a href="#home" class="block text-gray-700 font-medium hover:text-green-600" data-i18n="nav_home">Home</a>
            <a href="#facilities" class="block text-gray-700 font-medium hover:text-green-600" data-i18n="nav_facilities">Facilities</a>
            <a href="#opportunities" class="block text-gray-700 font-medium hover:text-green-600" data-i18n="nav_opportunities">Opportunities</a>
            <a href="#classes" class="block text-gray-700 font-medium hover:text-green-600" data-i18n="nav_classes">Classes</a>
            <a href="#memberships" class="block text-gray-700 font-medium hover:text-green-600" data-i18n="nav_memberships">Memberships</a>
            <a href="#contact" class="block text-gray-700 font-medium hover:text-green-600" data-i18n="nav_contact">Contact</a>
            <div class="pt-2 border-t border-gray-100">
                <select id="language-select-mobile" class="w-full bg-gray-100 border border-gray-300 text-gray-700 py-2 px-3 rounded-md text-sm font-semibold">
                    <option value="en">English</option>
                    <option value="es">Español</option>
                    <option value="ca">Català</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="pt-32 pb-20 bg-gradient-to-br from-green-900 via-gray-900 to-black text-white relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center relative z-10" data-aos="fade-up">
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6" data-i18n="hero_title">
                Welcome to Ace Sport Club
            </h1>
            <p class="text-lg sm:text-xl text-gray-300 max-w-3xl mx-auto mb-10" data-i18n="hero_subtitle">
                Your premier destination for Tennis, Padel, and Fitness in Pallejà.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#facilities" class="bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-4 rounded-xl shadow-lg transition transform hover:-translate-y-0.5" data-i18n="hero_btn_explore">
                    Explore Facilities
                </a>
                <a href="https://playtomic.io" target="_blank" class="bg-white hover:bg-gray-100 text-gray-900 font-bold px-8 py-4 rounded-xl shadow-lg transition transform hover:-translate-y-0.5" data-i18n="hero_btn_book">
                    Book on Playtomic
                </a>
            </div>
        </div>
    </section>

    <!-- Facilities Section -->
    <section id="facilities" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-900" data-i18n="facilities_title" data-aos="fade-up">
                Our Facilities
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Padel -->
                <div class="bg-gray-50 border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition" data-aos="fade-up">
                    <div class="text-green-500 text-3xl mb-4"><i class="fa-solid fa-table-tennis-paddle-ball"></i></div>
                    <h3 class="text-xl font-bold mb-2" data-i18n="fac_padel_title">11 Padel Courts</h3>
                    <p class="text-gray-600 text-sm" data-i18n="fac_padel_desc">High-quality courts available for booking.</p>
                </div>
                <!-- Tennis -->
                <div class="bg-gray-50 border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="100">
                    <div class="text-green-500 text-3xl mb-4"><i class="fa-solid fa-baseball"></i></div>
                    <h3 class="text-xl font-bold mb-2" data-i18n="fac_tennis_title">4 Tennis Courts</h3>
                    <p class="text-gray-600 text-sm" data-i18n="fac_tennis_desc">Excellent surfaces for players of all levels.</p>
                </div>
                <!-- Gym -->
                <div class="bg-gray-50 border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="200">
                    <div class="text-green-500 text-3xl mb-4"><i class="fa-solid fa-dumbbell"></i></div>
                    <h3 class="text-xl font-bold mb-2" data-i18n="fac_gym_title">Fully Equipped Gym</h3>
                    <p class="text-gray-600 text-sm" data-i18n="fac_gym_desc">Modern equipment for your fitness routine.</p>
                </div>
                <!-- Pool -->
                <div class="bg-gray-50 border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="300">
                    <div class="text-green-500 text-3xl mb-4"><i class="fa-solid fa-person-swimming"></i></div>
                    <h3 class="text-xl font-bold mb-2" data-i18n="fac_pool_title">Outside Swimming Pool</h3>
                    <p class="text-gray-600 text-sm" data-i18n="fac_pool_desc">Perfect for relaxing or swimming laps outdoors.</p>
                </div>
                <!-- Classes Rooms -->
                <div class="bg-gray-50 border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="400">
                    <div class="text-green-500 text-3xl mb-4"><i class="fa-solid fa-users"></i></div>
                    <h3 class="text-xl font-bold mb-2" data-i18n="fac_classes_title">2 Inside Spaces</h3>
                    <p class="text-gray-600 text-sm" data-i18n="fac_classes_desc">Dedicated rooms for guided exercise classes.</p>
                </div>
                <!-- Restaurant -->
                <div class="bg-gray-50 border border-gray-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition" data-aos="fade-up" data-aos-delay="500">
                    <div class="text-green-500 text-3xl mb-4"><i class="fa-solid fa-utensils"></i></div>
                    <h3 class="text-xl font-bold mb-2" data-i18n="fac_restaurant_title">Restaurant & Changing Rooms</h3>
                    <p class="text-gray-600 text-sm" data-i18n="fac_restaurant_desc">Refuel after your workout and enjoy our comfortable amenities.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Opportunities & Services -->
    <section id="opportunities" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-900" data-i18n="opp_title" data-aos="fade-up">
                Opportunities & Services
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100" data-aos="fade-right">
                    <h3 class="text-2xl font-bold mb-3 text-gray-900" data-i18n="opp_school_title">Padel and Tennis School</h3>
                    <p class="text-gray-600" data-i18n="opp_school_desc">Improve your game with our professional instructors. We offer classes for all ages and skill levels.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100" data-aos="fade-left">
                    <h3 class="text-2xl font-bold mb-3 text-gray-900" data-i18n="opp_classes_title">Guided Physical Activity</h3>
                    <p class="text-gray-600" data-i18n="opp_classes_desc">Join our diverse range of guided classes in our dedicated indoor spaces. Stay fit and motivated!</p>
                </div>
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100" data-aos="fade-right">
                    <h3 class="text-2xl font-bold mb-3 text-gray-900" data-i18n="opp_events_title">Events & Tournaments</h3>
                    <p class="text-gray-600" data-i18n="opp_events_desc">Participate in our regular tournaments and club events. Great for competition and community building.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100" data-aos="fade-left">
                    <h3 class="text-2xl font-bold mb-3 text-gray-900" data-i18n="opp_booking_title">Easy Booking via Playtomic</h3>
                    <p class="text-gray-600" data-i18n="opp_booking_desc">Book your padel or tennis courts effortlessly through the Playtomic app.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Guided Classes Timetable -->
    <section id="classes" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10" data-aos="fade-up">
                <h2 class="text-3xl font-bold text-gray-900 mb-3" data-i18n="tt_title">Guided Classes Timetable</h2>
                <p class="text-gray-600" data-i18n="tt_subtitle">Check out the schedule for our guided physical activities in Sala 1 and Sala 2.</p>
            </div>

            <!-- Sala Toggle Buttons -->
            <div class="flex justify-center space-x-4 mb-8" data-aos="fade-up">
                <button id="tab-sala1" class="px-6 py-2.5 rounded-xl font-bold bg-green-500 text-white shadow-md transform scale-105 transition-all">
                    Sala 1
                </button>
                <button id="tab-sala2" class="px-6 py-2.5 rounded-xl font-bold bg-gray-200 text-gray-700 hover:bg-gray-300 transition-all">
                    Sala 2
                </button>
            </div>

            <!-- Timetable Container generated by script.js -->
            <div class="overflow-x-auto bg-white rounded-2xl shadow-lg border border-gray-100 p-4" data-aos="fade-up">
                <div id="timetable-schedule" class="min-w-[800px]"></div>
            </div>

            <div class="text-center mt-8">
                <a href="https://playtomic.io" target="_blank" class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-3 rounded-xl shadow-md transition" data-i18n="tt_book_btn">
                    Book your class
                </a>
            </div>
        </div>
    </section>

    <!-- Memberships Section -->
    <section id="memberships" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12" data-aos="fade-up">
                <h2 class="text-3xl font-bold text-gray-900 mb-3" data-i18n="mem_title">Memberships</h2>
                <p class="text-gray-600" data-i18n="mem_subtitle">Choose the membership that best suits your lifestyle.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                <!-- Membership Card 1 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_adult_title">Abonado Adulto</h3>
                        <p class="text-sm text-gray-600" data-i18n="mem_adult_desc">Full membership. Includes children under 8. From 14 years old.</p>
                    </div>
                </div>
                <!-- Membership Card 2 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_padel_title">Abonado Pádel</h3>
                        <p class="text-sm text-gray-600" data-i18n="mem_padel_desc">From 14 years old.</p>
                    </div>
                </div>
                <!-- Membership Card 3 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="200">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_gym_title">Abonado Gym</h3>
                        <p class="text-sm text-gray-600" data-i18n="mem_gym_desc">From 14 years old.</p>
                    </div>
                </div>
                <!-- Membership Card 4 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="300">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_gymclass_title">Gym + Unlimited Classes</h3>
                        <p class="text-sm text-gray-600" data-i18n="mem_gymclass_desc">Gym access and unlimited guided classes.</p>
                    </div>
                </div>
                <!-- Membership Card 5 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_class2h_title">Guided Classes 2h/week</h3>
                        <p class="text-sm text-gray-600" data-i18n="mem_class2h_desc">2 hours of guided classes per week.</p>
                    </div>
                </div>
                <!-- Membership Card 6 -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="100">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_classunlim_title">Unlimited Guided Classes</h3>
                        <p class="text-sm text-gray-600" data-i18n="mem_classunlim_desc">Unlimited guided classes.</p>
                    </div>
                </div>
                <!-- Membership Card 7 (Best Value) -->
                <div class="bg-green-50 border-2 border-green-500 p-6 rounded-2xl shadow-md flex flex-col justify-between relative" data-aos="fade-up" data-aos-delay="200">
                    <span class="absolute -top-3 right-4 bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider" data-i18n="mem_badge">Best Value</span>
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2" data-i18n="mem_complete_title">Full + Unlimited Classes</h3>
                        <p class="text-sm text-gray-700" data-i18n="mem_complete_desc">All-inclusive: full club access and unlimited guided classes.</p>
                    </div>
                </div>
                <!-- Membership Card 8 (Family) -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between" data-aos="fade-up" data-aos-delay="300">
                    <div>
                        <div class="flex justify-between items-start mb-2">
                            <h3 class="text-lg font-bold text-gray-900" data-i18n="mem_family_title">Family Membership</h3>
                            <span class="text-green-600 font-bold" data-i18n="mem_family_price">from 94€</span>
                        </div>
                        <p class="text-xs text-gray-500" data-i18n="mem_family_note">A = Adults (14+) · N = Children aged 8–14</p>
                    </div>
                </div>
            </div>

            <!-- Notes & Terms -->
            <div class="bg-white rounded-2xl p-6 border border-gray-200 text-sm text-gray-600 space-y-2 mb-8">
                <p><strong class="text-gray-900" data-i18n="mem_note1_bold">Registration fee:</strong> <span data-i18n="mem_note1">equal to two monthly fees of the chosen plan.</span></p>
                <p data-i18n="mem_note2">Children under 8 will be included as members in the file, even if not reflected in the Adult or Family membership fee.</p>
                <p data-i18n="mem_note3">Unlimited guided classes will have a surcharge of €15 per family member.</p>
            </div>

            <div class="text-center">
                <a href="#contact" class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold px-10 py-4 rounded-xl shadow-lg transition transform hover:-translate-y-0.5" data-i18n="mem_cta">
                    Become a member now!
                </a>
            </div>
        </div>
    </section>

    <!-- Contact & Location -->
    <section id="contact" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-center mb-12 text-gray-900" data-i18n="contact_title" data-aos="fade-up">
                Contact & Location
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <div class="space-y-6" data-aos="fade-right">
                    <div class="flex items-start space-x-4">
                        <div class="text-green-500 text-2xl mt-1"><i class="fa-solid fa-location-dot"></i></div>
                        <div>
                            <h4 class="font-bold text-gray-900" data-i18n="contact_address_label">Address</h4>
                            <p class="text-gray-600">Pallejà, Barcelona, Spain</p>
                        </div>
                    </div>
                    <div class="flex items-start space-x-4">
                        <div class="text-green-500 text-2xl mt-1"><i class="fa-solid fa-phone"></i></div>
                        <div>
                            <h4 class="font-bold text-gray-900" data-i18n="contact_phone_label">Phone</h4>
                            <p class="text-gray-600">+34 93X XX XX XX</p>
                        </div>
                    </div>
                </div>

                <!-- Google Maps Placeholder / Embed -->
                <div class="bg-gray-100 rounded-2xl h-64 flex items-center justify-center border border-gray-200" data-aos="fade-left">
                    <span class="text-gray-400 font-medium"><i class="fa-solid fa-map-location-dot text-4xl block mb-2 text-center"></i> Map Location (Pallejà)</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-400 py-8 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center text-sm">
            <p>&copy; Ace Sport Club. <span data-i18n="footer_rights">All rights reserved.</span></p>
        </div>
    </footer>

    <!-- AOS Script CDN -->
    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <!-- Custom JS -->
    <script src="script.js"></script>
</body>
</html>
